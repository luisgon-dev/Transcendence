# Copy this file to `.env` before running `docker compose`.

# Core application ports
WEB_PORT=3000
WEBAPI_PORT=8080
DOZZLE_PORT=9999

# Database and cache
POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changme
REDIS_CONNECTION=redis:6379

# Postgres memory tuning (passed to `postgres -c` by compose). Unset = Postgres defaults, which is
# correct for local dev — do NOT raise these on a small Docker VM. PROD (the 16GB host) sets the
# tuned values below in its Portainer stack.env to resolve the 2026-06-21 DB-saturation incident;
# kept here as the canonical, version-controlled values. See scripts/ops/README.md.
#   POSTGRES_SHARED_BUFFERS=4GB
#   POSTGRES_WORK_MEM=24MB
#   POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
#   POSTGRES_MAINTENANCE_WORK_MEM=512MB
#   POSTGRES_SHM_SIZE=1gb
#   POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
#   POSTGRES_TRACK_IO_TIMING=on
#   POSTGRES_LOG_TEMP_FILES_KB=65536

# Per-process database pool budgets. Keep their sum below Postgres max_connections with headroom for
# administration/exporters. Defaults reserve 45 of the current 100 connections.
WEBAPI_DB_POOL_MAX=20
SERVICE_DB_POOL_MAX=35

# Container guardrails. PostgreSQL is intentionally not memory-capped; size it from its measured
# working set and leave host headroom instead.
WEB_CPUS=2.0
WEB_MEMORY_LIMIT=1g
WEBAPI_CPUS=4.0
WEBAPI_MEMORY_LIMIT=2g
SERVICE_CPUS=8.0
SERVICE_MEMORY_LIMIT=6g

# Adjusted WPA shadow pipeline. Enabling the Compose profile starts the offline modeler; it never serves
# web traffic. BUILD_LAB_ENABLED is the single switch: it drives Analytics__BuildLab__Enabled on BOTH the
# worker (generation + promotion, the timeline extras, and the schema version an ingest targets) and the
# WebAPI (serving), plus both Jobs__Schedule__Enable*BuildLabGeneration keys on the worker.
# Flipping it to true is what STARTS the v2 timeline backfill (no v2 coverage can exist before it): the
# whole retained corpus is re-fetched once at the rate-gated pace, so read
# docs/DEVELOPMENT.md -> "Enabling Build Lab on an existing corpus" before spending that Riot budget.
BUILD_LAB_ENABLED=false
BUILD_LAB_CODE_REVISION=local
BUILD_LAB_MODELER_CPUS=4.0
BUILD_LAB_MODELER_MEMORY_LIMIT=8g
BUILD_LAB_POLL_SECONDS=300
# true = process one pending generation and exit (one-shot backfill / debugging), never for the
# long-running container.
BUILD_LAB_RUN_ONCE=false
# SECRET — leave EMPTY here and set a strong random value (>= 32 chars, e.g. `openssl rand -hex 32`)
# in the real .env before enabling Build Lab. It keys the HMAC surrogate match/participant ids in the
# deidentified Parquet export; a guessable salt makes the export re-identifiable. The modeler refuses
# to start when it is empty or shorter than 32 characters. Never commit a real value.
BUILD_LAB_DEIDENTIFICATION_SALT=
# Exclusivity is a PostgreSQL session advisory lock the modeler holds for the whole run, so there
# is nothing to tune here: a crashed or killed modeler drops its session and the lock with it, and
# the coordinator decides abandonment by probing that same lock rather than by any timeout.
# Chronological sample ceiling for the structural win model's design matrix (floor 20000).
BUILD_LAB_MAX_TRAINING_ROWS=250000
BUILD_LAB_LOG_LEVEL=INFO
# Pin the modeler image for a rollback (`:sha-<short>`); unset tracks `:main` like the app services.
# MODELER_IMAGE=ghcr.io/luisgon-dev/transcendence-analytics-modeler:main
# Optional S3-compatible durable artifacts. When unset, the modeler uses build_lab_artifacts.
BUILD_LAB_S3_ENDPOINT=
BUILD_LAB_S3_BUCKET=
BUILD_LAB_S3_ACCESS_KEY=
BUILD_LAB_S3_SECRET_KEY=
# Independent public-consumer flags. Promote a generation before enabling these surfaces.
TRN_FEATURE_BUILD_LAB=false
TRN_FEATURE_CHAMPION_RECOMMENDATIONS=false
TRN_FEATURE_BUILD_REFERENCE_LINKS=false

# Riot API key
RIOT_API_KEY_LOL=RGAPI-CHANGE_ME

# Web API auth
JWT_ISSUER=Transcendence
JWT_AUDIENCE=TranscendenceClients
JWT_SIGNING_KEY=CHANGE_ME_TO_A_32+_CHAR_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
AUTH_BOOTSTRAP_API_KEY=CHANGE_ME_BOOTSTRAP_KEY
ADMIN_BOOTSTRAP_EMAIL_0=admin@example.com

# Password recovery (optional; leave disabled until SMTP is configured)
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_PUBLIC_BASE_URL=https://transcend.kronic.one
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
PASSWORD_RESET_SMTP_HOST=smtp.example.com
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_ENABLE_SSL=true
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_SMTP_FROM_NAME=Transcendence

# Riot Sign On (optional; requires an approved production RSO client)
RIOT_RSO_ENABLED=false
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=https://transcend.kronic.one/api/session/riot/callback

# Web frontend -> backend integration
WEB_TRN_BACKEND_API_KEY=CHANGE_ME_WEB_APPONLY_KEY
# User-visible proxy errors omit internal upstream detail by default. Local debugging only: verbose.
TRN_ERROR_VERBOSITY=safe

# Optional utility service credentials
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# Observability (Prometheus + Grafana) is its own stack — see config/monitoring/ and its .env.example
# (Grafana alert-webhook lives there, not here).
