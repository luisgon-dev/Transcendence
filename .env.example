# Copy this file to `.env` before running `docker compose`.

# Core application ports
WEB_PORT=3000
WEBAPI_PORT=8080
DOZZLE_PORT=9999

# Database and cache
POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changme
REDIS_CONNECTION=redis:6379

# Postgres memory tuning (passed to `postgres -c` by compose). Unset = Postgres defaults, which is
# correct for local dev — do NOT raise these on a small Docker VM. PROD (the 16GB host) sets the
# tuned values below in its Portainer stack.env to resolve the 2026-06-21 DB-saturation incident;
# kept here as the canonical, version-controlled values. See scripts/ops/README.md.
#   POSTGRES_SHARED_BUFFERS=4GB
#   POSTGRES_WORK_MEM=24MB
#   POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
#   POSTGRES_MAINTENANCE_WORK_MEM=512MB
#   POSTGRES_SHM_SIZE=1gb
#   POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
#   POSTGRES_TRACK_IO_TIMING=on
#   POSTGRES_LOG_TEMP_FILES_KB=65536

# Per-process database pool budgets. Keep their sum below Postgres max_connections with headroom for
# administration/exporters. Defaults reserve 45 of the current 100 connections.
WEBAPI_DB_POOL_MAX=20
SERVICE_DB_POOL_MAX=35

# Container guardrails. PostgreSQL is intentionally not memory-capped; size it from its measured
# working set and leave host headroom instead.
WEB_CPUS=2.0
WEB_MEMORY_LIMIT=1g
WEBAPI_CPUS=4.0
WEBAPI_MEMORY_LIMIT=2g
SERVICE_CPUS=8.0
SERVICE_MEMORY_LIMIT=6g

# Riot API key
RIOT_API_KEY_LOL=RGAPI-CHANGE_ME

# Web API auth
JWT_ISSUER=Transcendence
JWT_AUDIENCE=TranscendenceClients
JWT_SIGNING_KEY=CHANGE_ME_TO_A_32+_CHAR_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
AUTH_BOOTSTRAP_API_KEY=CHANGE_ME_BOOTSTRAP_KEY
ADMIN_BOOTSTRAP_EMAIL_0=admin@example.com

# Password recovery (optional; leave disabled until SMTP is configured)
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_PUBLIC_BASE_URL=https://transcend.kronic.one
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
PASSWORD_RESET_SMTP_HOST=smtp.example.com
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_ENABLE_SSL=true
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_SMTP_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_SMTP_FROM_NAME=Transcendence

# Riot Sign On (optional; requires an approved production RSO client)
RIOT_RSO_ENABLED=false
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=https://transcend.kronic.one/api/session/riot/callback

# Web frontend -> backend integration
WEB_TRN_BACKEND_API_KEY=CHANGE_ME_WEB_APPONLY_KEY
# User-visible proxy errors omit internal upstream detail by default. Local debugging only: verbose.
TRN_ERROR_VERBOSITY=safe

# Optional utility service credentials
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# Observability (Prometheus + Grafana) is its own stack — see config/monitoring/ and its .env.example
# (Grafana alert-webhook lives there, not here).
