{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  },
  "ConnectionStrings": {
    "MainDatabase": "Server=.;Database=ProjectSyndra;Trusted_Connection=True;MultipleActiveResultSets=true",
    "RiotApi": "RGAPI-00000000-0000-0000-0000-000000000000"
  },
  "RiotApi": {
    "League": {
      "ApiKey": "RGAPI-00000000-0000-0000-0000-000000000000"
    },
    "Tft": {
      "ApiKey": "RGAPI-00000000-0000-0000-0000-000000000000"
    }
  },
  "Analytics": {
    "Compute": {
      "MinimumGamesRequired": 100,
      "EarlyPatchMinimumGamesRequired": 35,
      "EarlyPatchWindowHours": 96
    }
  },
  "Jobs": {
    "Hangfire": {
      "GlobalRetryAttempts": 1
    },
    "Schedule": {
      "Profile": "development",
      "DefaultProfile": "default",
      "RefreshLockLifecycleCleanupCron": "*/5 * * * *",
      "TftStaticDataCron": "30 */6 * * *",
      "TftAnalyticsRefreshCron": "*/30 * * * *",
      "TftAnalyticsIngestionCron": "*/15 * * * *",
      "TftSummonerMaintenanceCron": "*/20 * * * *",
      "EnableRefreshLockLifecycleCleanup": true,
      "EnableTftStaticDataRefresh": true,
      "EnableTftAnalyticsRefresh": true,
      "EnableTftAnalyticsIngestion": true,
      "EnableTftSummonerMaintenance": true,
      "RefreshLockLifecycleForensicsWindowMinutes": 30,
      "RefreshLockLifecycleCleanupBatchSize": 100,
      "RefreshLockLifecycleCleanupMaxBatchesPerRun": 4,
      "CleanupOnStartup": false,
      "RunPatchDetectionOnStartup": true
    },
    "SchedulingProfiles": {
      "Profiles": {
        "development": {
          "JobOverrides": {
            "refresh-champion-analytics-adaptive": {
              "Cron": "*/10 * * * *"
            },
            "champion-analytics-ingestion": {
              "Cron": "*/5 * * * *"
            },
            "summoner-maintenance": {
              "Cron": "*/15 * * * *"
            },
            "rune-selection-integrity-backfill": {
              "Cron": "*/10 * * * *"
            },
            "refresh-lock-lifecycle-cleanup": {
              "Cron": "*/2 * * * *"
            },
            "tft-analytics-ingestion": {
              "Cron": "*/10 * * * *"
            },
            "tft-summoner-maintenance": {
              "Cron": "*/15 * * * *"
            }
          }
        }
      }
    },
    "LiveGamePolling": {
      "MaxTrackedSummonersPerRun": 20,
      "MaxRiotRequestsPerRun": 15,
      "PollOnlyFavoriteSummoners": true,
      "RespectUserLivePollingPreference": true,
      "PauseWhileChampionAnalyticsUnavailable": true
    },
    "RetryFailedMatches": {
      "MaxMatchesPerRun": 3,
      "MinimumMinutesSinceLastAttempt": 15
    },
    "RefreshChampionAnalytics": {
      "PopularChampionsTakeCount": 75,
      "ChampionsPerRoleToPreWarm": 8,
      "AdaptiveNewMatchesThreshold": 120,
      "AdaptiveLookbackMinutes": 30,
      "MinimumRefreshIntervalMinutes": 45,
      "ForceRefreshAfterHours": 8,
      "EnqueueIngestionWhenNoPopularChampions": true,
      "NewPatchRampHours": 48,
      "RampChampionsPerRoleToPreWarm": 20,
      "RampAdaptiveNewMatchesThreshold": 100,
      "RampAdaptiveLookbackMinutes": 10,
      "RampMinimumRefreshIntervalMinutes": 10,
      "RampForceRefreshAfterHours": 2
    },
    "ChampionAnalyticsIngestion": {
      "MinimumSuccessfulMatchesForCurrentPatch": 120,
      "TargetSuccessfulMatchesForCurrentPatch": 300,
      "DataStaleAfterMinutes": 45,
      "MaxCandidateSummonersPerRun": 50,
      "MinRefreshJobsToQueuePerRun": 1,
      "MaxRefreshJobsToQueuePerRun": 5,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "FallbackToTrackedSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampDataStaleAfterMinutes": 30,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMinRefreshJobsToQueuePerRun": 6,
      "RampMaxRefreshJobsToQueuePerRun": 20
    },
    "IngestionPriorityPolicy": {
      "PatchRelevanceWeight": 8.0,
      "StalenessWeight": 4.0,
      "FavoriteWeight": 2.0,
      "StalenessSaturationMinutes": 180
    },
    "SummonerMaintenance": {
      "MaxCandidateSummonersPerRun": 40,
      "MaxRefreshJobsToQueuePerRun": 3,
      "DataStaleAfterMinutes": 45,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMaxRefreshJobsToQueuePerRun": 12,
      "RampDataStaleAfterMinutes": 30
    },
    "MatchIngestion": {
      "MatchIdsPageSize": 20,
      "HighPriorityRankedPages": 2,
      "HighPriorityAllModesHeadPages": 2,
      "HighPriorityNonRankedBackfillMaxPages": 20,
      "LowPriorityRankedPages": 1,
      "LowPriorityAllModesHeadPages": 1,
      "LowPriorityNonRankedBackfillMaxPages": 2
    },
    "TimelineIngestion": {
      "Enabled": true,
      "MinuteMark": 15,
      "MaxRetryAttempts": 4,
      "BackfillBatchSize": 60,
      "BackfillMaxEnqueuesPerRun": 25,
      "BackfillCurrentPatchOnly": true,
      "PauseWhenApiPriorityRefreshActive": true
    },
    "RuneSelectionIntegrityBackfill": {
      "BatchSize": 150,
      "MaxBatchesPerRun": 8
    },
    "SummonerBootstrap": {
      "Enabled": true,
      "PlatformRegion": "NA1",
      "ChallengerSeedCount": 50,
      "LockMinutes": 10
    }
  }
}
