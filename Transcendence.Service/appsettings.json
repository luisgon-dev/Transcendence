{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OperationalLogs": {
    "ServiceName": "service",
    "DirectoryPath": "logs",
    "MinLevel": "Information"
  },
  "ConnectionStrings": {
    "MainDatabase": "Server=;Port=;Database=;Password=;Username=",
    "RiotApi": "RGAPI-00000000-0000-0000-0000-000000000000",
    "Redis": "localhost:6379"
  },
  "Analytics": {
    "Compute": {
      "MinimumGamesRequired": 100,
      "EarlyPatchMinimumGamesRequired": 40,
      "EarlyPatchWindowHours": 72
    }
  },
  "Jobs": {
    "Hangfire": {
      "GlobalRetryAttempts": 1
    },
    "Schedule": {
      "Profile": "default",
      "DefaultProfile": "default",
      "DetectPatchCron": "0 */6 * * *",
      "RetryFailedMatchesCron": "0 * * * *",
      "RefreshChampionAnalyticsDailyCron": "0 4 * * *",
      "RefreshChampionAnalyticsAdaptiveCron": "*/15 * * * *",
      "RefreshChampionAnalyticsRampCron": "*/5 * * * *",
      "ChampionAnalyticsIngestionCron": "*/10 * * * *",
      "ChampionAnalyticsIngestionRampCron": "*/2 * * * *",
      "SummonerMaintenanceCron": "*/20 * * * *",
      "SummonerMaintenanceRampCron": "*/5 * * * *",
      "MatchTimelineBackfillCron": "*/10 * * * *",
      "RuneSelectionIntegrityBackfillCron": "*/15 * * * *",
      "LiveGamePollingCron": "*/2 * * * *",
      "RefreshLockLifecycleCleanupCron": "*/5 * * * *",
      "EnableAdaptiveAnalyticsRefresh": true,
      "EnableNewPatchRamp": true,
      "EnableChampionAnalyticsIngestion": true,
      "EnableSummonerMaintenance": true,
      "EnableMatchTimelineBackfill": true,
      "EnableRuneSelectionIntegrityBackfill": true,
      "EnableRefreshLockLifecycleCleanup": true,
      "RefreshLockLifecycleForensicsWindowMinutes": 30,
      "RefreshLockLifecycleCleanupBatchSize": 250,
      "RefreshLockLifecycleCleanupMaxBatchesPerRun": 8,
      "CleanupOnStartup": false,
      "RunPatchDetectionOnStartup": true
    },
    "SchedulingProfiles": {
      "Profiles": {
        "default": {}
      }
    },
    "LiveGamePolling": {
      "MaxTrackedSummonersPerRun": 30,
      "MaxRiotRequestsPerRun": 20,
      "PollOnlyFavoriteSummoners": true,
      "RespectUserLivePollingPreference": true,
      "PauseWhileChampionAnalyticsUnavailable": true
    },
    "RetryFailedMatches": {
      "MaxMatchesPerRun": 5,
      "MinimumMinutesSinceLastAttempt": 15
    },
    "RefreshChampionAnalytics": {
      "PopularChampionsTakeCount": 100,
      "ChampionsPerRoleToPreWarm": 12,
      "AdaptiveNewMatchesThreshold": 250,
      "AdaptiveLookbackMinutes": 30,
      "MinimumRefreshIntervalMinutes": 60,
      "ForceRefreshAfterHours": 12,
      "EnqueueIngestionWhenNoPopularChampions": true,
      "NewPatchRampHours": 48,
      "RampChampionsPerRoleToPreWarm": 20,
      "RampAdaptiveNewMatchesThreshold": 100,
      "RampAdaptiveLookbackMinutes": 10,
      "RampMinimumRefreshIntervalMinutes": 10,
      "RampForceRefreshAfterHours": 2
    },
    "ChampionAnalyticsIngestion": {
      "MinimumSuccessfulMatchesForCurrentPatch": 200,
      "TargetSuccessfulMatchesForCurrentPatch": 400,
      "DataStaleAfterMinutes": 90,
      "MaxCandidateSummonersPerRun": 75,
      "MinRefreshJobsToQueuePerRun": 1,
      "MaxRefreshJobsToQueuePerRun": 6,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "FallbackToTrackedSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampDataStaleAfterMinutes": 30,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMinRefreshJobsToQueuePerRun": 6,
      "RampMaxRefreshJobsToQueuePerRun": 20
    },
    "IngestionPriorityPolicy": {
      "PatchRelevanceWeight": 8.0,
      "StalenessWeight": 4.0,
      "FavoriteWeight": 2.0,
      "StalenessSaturationMinutes": 180
    },
    "AdaptiveThroughputBudget": {
      "VelocityLookbackMinutes": 30,
      "HighPressureCooldownMinutes": 8,
      "CatchUpHoldMinutes": 12,
      "ModeSwitchCooldownMinutes": 4,
      "CatchUpCoverageThreshold": 0.85,
      "CatchUpBacklogAgeMinutes": 45,
      "CatchUpCandidatePressureThreshold": 1.1,
      "MinimumRecentVelocityPerHour": 12.0,
      "CatchUpQueueBurstMultiplier": 1.6,
      "CatchUpCandidateBurstMultiplier": 1.8,
      "HighPressureCandidateMultiplier": 0.25,
      "MaxQueueTargetHardCap": 40,
      "MaxCandidateHardCap": 500
    },
    "StarvationGuardrail": {
      "Enabled": true,
      "MaxEligibleDeferAgeMinutes": 360,
      "CatchUpWindowMinutes": 12,
      "CatchUpCooldownMinutes": 20,
      "ForcedCatchUpQueueTargetFloor": 1,
      "ForcedCatchUpCandidateBurstMultiplier": 1.5,
      "ForcedCatchUpMaxCandidateHardCap": 500
    },
    "SummonerMaintenance": {
      "MaxCandidateSummonersPerRun": 60,
      "MaxRefreshJobsToQueuePerRun": 4,
      "DataStaleAfterMinutes": 90,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMaxRefreshJobsToQueuePerRun": 12,
      "RampDataStaleAfterMinutes": 30
    },
    "MatchIngestion": {
      "MatchIdsPageSize": 20,
      "HighPriorityRankedPages": 2,
      "HighPriorityAllModesHeadPages": 2,
      "HighPriorityNonRankedBackfillMaxPages": 40,
      "LowPriorityRankedPages": 1,
      "LowPriorityAllModesHeadPages": 1,
      "LowPriorityNonRankedBackfillMaxPages": 4
    },
    "TimelineIngestion": {
      "Enabled": true,
      "MinuteMark": 15,
      "MaxRetryAttempts": 4,
      "BackfillBatchSize": 100,
      "BackfillMaxEnqueuesPerRun": 50,
      "BackfillCurrentPatchOnly": true,
      "PauseWhenApiPriorityRefreshActive": true
    },
    "RuneSelectionIntegrityBackfill": {
      "BatchSize": 250,
      "MaxBatchesPerRun": 10
    },
    "SummonerBootstrap": {
      "Enabled": true,
      "PlatformRegion": "NA1",
      "ChallengerSeedCount": 50,
      "LockMinutes": 10
    }
  }
}
