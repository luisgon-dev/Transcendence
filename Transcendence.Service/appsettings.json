{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OperationalLogs": {
    "ServiceName": "service",
    "DirectoryPath": "logs",
    "MinLevel": "Information"
  },
  "Jobs": {
    "Hangfire": {
      "GlobalRetryAttempts": 1
    },
    "Schedule": {
      "Profile": "stable",
      "DefaultProfile": "stable",
      "DetectPatchCron": "0 */6 * * *",
      "RetryFailedMatchesCron": "0 * * * *",
      "RefreshChampionAnalyticsDailyCron": "0 4 * * *",
      "RefreshChampionAnalyticsAdaptiveCron": "*/5 * * * *",
      "WarmDefaultChampionProfilesCron": "0 * * * *",
      "RefreshPrecomputedAnalyticsCron": "30 * * * *",
      "ChampionAnalyticsIngestionCron": "*/2 * * * *",
      "SummonerMaintenanceCron": "*/5 * * * *",
      "MatchTimelineBackfillCron": "*/10 * * * *",
      "RuneSelectionIntegrityBackfillCron": "*/15 * * * *",
      "LiveGamePollingCron": "*/2 * * * *",
      "RefreshLockLifecycleCleanupCron": "*/5 * * * *",
      "EnableAdaptiveAnalyticsRefresh": true,
      "EnableWarmDefaultChampionProfiles": true,
      "EnableRefreshPrecomputedAnalytics": true,
      "EnableChampionAnalyticsIngestion": true,
      "EnableSummonerMaintenance": true,
      "EnableMatchTimelineBackfill": true,
      "EnableRuneSelectionIntegrityBackfill": true,
      "EnableHighEloProfileRefresh": true,
      "HighEloProfileRefreshCron": "0 */12 * * *",
      "EnableRefreshLockLifecycleCleanup": true,
      "RefreshLockLifecycleForensicsWindowMinutes": 30,
      "RefreshLockLifecycleCleanupBatchSize": 250,
      "RefreshLockLifecycleCleanupMaxBatchesPerRun": 8,
      "CleanupOnStartup": false,
      "RunPatchDetectionOnStartup": true,
      "PurgeBacklogOnPatchRolloverOnStartup": false
    },
    "SchedulingProfiles": {
      "Profiles": {
        "default": {},
        "stable": {
          "JobOverrides": {
            "refresh-champion-analytics": { "Enabled": false },
            "refresh-champion-analytics-adaptive": { "Enabled": true, "Cron": "*/5 * * * *" },
            "champion-analytics-ingestion": { "Enabled": true, "Cron": "*/2 * * * *" },
            "summoner-maintenance": { "Enabled": true, "Cron": "*/5 * * * *" },
            "match-timeline-backfill": { "Enabled": true, "Cron": "*/5 * * * *" },
            "rune-selection-integrity-backfill": { "Enabled": false },
            "poll-live-games": { "Enabled": false },
            "high-elo-profile-refresh": { "Enabled": true, "Cron": "0 */2 * * *" }
          }
        }
      }
    },
    "LiveGamePolling": {
      "MaxTrackedSummonersPerRun": 30,
      "MaxRiotRequestsPerRun": 20,
      "PollOnlyFavoriteSummoners": true,
      "RespectUserLivePollingPreference": true,
      "PauseWhileChampionAnalyticsUnavailable": true
    },
    "RetryFailedMatches": {
      "MaxMatchesPerRun": 5,
      "MinimumMinutesSinceLastAttempt": 15
    },
    "RefreshChampionAnalytics": {
      "PopularChampionsTakeCount": 100,
      "ChampionsPerRoleToPreWarm": 12,
      "AdaptiveNewMatchesThreshold": 250,
      "AdaptiveLookbackMinutes": 30,
      "MinimumRefreshIntervalMinutes": 60,
      "ForceRefreshAfterHours": 12,
      "EnqueueIngestionWhenNoPopularChampions": true,
      "NewPatchRampHours": 48,
      "RampChampionsPerRoleToPreWarm": 20,
      "RampAdaptiveNewMatchesThreshold": 100,
      "RampAdaptiveLookbackMinutes": 10,
      "RampMinimumRefreshIntervalMinutes": 10,
      "RampForceRefreshAfterHours": 2
    },
    "WarmDefaultChampionProfiles": {
      "RankTier": "EMERALD_PLUS",
      "MinimumGamesToWarm": 50,
      "MaxConcurrency": 3,
      "IncludeProBuilds": true
    },
    "ChampionAnalyticsIngestion": {
      "MinimumSuccessfulMatchesForCurrentPatch": 5000,
      "TargetSuccessfulMatchesForCurrentPatch": 25000,
      "DataStaleAfterMinutes": 90,
      "MaxCandidateSummonersPerRun": 250,
      "MinRefreshJobsToQueuePerRun": 1,
      "MaxRefreshJobsToQueuePerRun": 20,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "PrioritizeTrackedHighValueSummoners": true,
      "PrioritizeRankedHighEloSummoners": true,
      "FallbackToTrackedSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampDataStaleAfterMinutes": 30,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMinRefreshJobsToQueuePerRun": 6,
      "RampMaxRefreshJobsToQueuePerRun": 20,
      "DiscoveryQueueBackpressureSoftCap": 5000,
      "DiscoveryQueueBackpressureHardCap": 10000,
      "HighEloTiers": [ "CHALLENGER", "GRANDMASTER", "MASTER", "DIAMOND", "EMERALD" ]
    },
    "IngestionPriorityPolicy": {
      "PatchRelevanceWeight": 8.0,
      "StalenessWeight": 4.0,
      "FavoriteWeight": 2.0,
      "StalenessSaturationMinutes": 180
    },
    "AdaptiveThroughputBudget": {
      "VelocityLookbackMinutes": 30,
      "HighPressureCooldownMinutes": 8,
      "CatchUpHoldMinutes": 12,
      "ModeSwitchCooldownMinutes": 4,
      "CatchUpCoverageThreshold": 0.85,
      "CatchUpBacklogAgeMinutes": 45,
      "CatchUpCandidatePressureThreshold": 1.1,
      "MinimumRecentVelocityPerHour": 12.0,
      "CatchUpQueueBurstMultiplier": 1.6,
      "CatchUpCandidateBurstMultiplier": 1.8,
      "HighPressureCandidateMultiplier": 0.25,
      "MaxQueueTargetHardCap": 60,
      "MaxCandidateHardCap": 800
    },
    "StarvationGuardrail": {
      "Enabled": false,
      "MaxEligibleDeferAgeMinutes": 360,
      "CatchUpWindowMinutes": 12,
      "CatchUpCooldownMinutes": 20,
      "ForcedCatchUpQueueTargetFloor": 1,
      "ForcedCatchUpCandidateBurstMultiplier": 1.5,
      "ForcedCatchUpMaxCandidateHardCap": 500
    },
    "SummonerMaintenance": {
      "MaxCandidateSummonersPerRun": 150,
      "MaxRefreshJobsToQueuePerRun": 10,
      "DataStaleAfterMinutes": 90,
      "RefreshLockMinutes": 10,
      "PrioritizeFavoriteSummoners": true,
      "PrioritizeTrackedHighValueSummoners": true,
      "PrioritizeRankedHighEloSummoners": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "NewPatchRampHours": 48,
      "RampMaxCandidateSummonersPerRun": 250,
      "RampMaxRefreshJobsToQueuePerRun": 12,
      "RampDataStaleAfterMinutes": 30,
      "HighEloTiers": [ "CHALLENGER", "GRANDMASTER", "MASTER", "DIAMOND", "EMERALD" ]
    },
    "MatchIngestion": {
      "MatchIdsPageSize": 100,
      "HighPriorityRankedPages": 2,
      "HighPriorityAllModesHeadPages": 2,
      "HighPriorityNonRankedBackfillMaxPages": 40,
      "LowPriorityRankedPages": 3,
      "LowPriorityAllModesHeadPages": 1,
      "LowPriorityNonRankedBackfillMaxPages": 4,
      "AnalyticsRecentWindowDays": 4
    },
    "FullHistoryBackfill": {
      "Enabled": true,
      "PageSize": 100,
      "MaxPagesPerRun": 5,
      "MaxFailureRetriesPerRun": 25,
      "MinimumMatchStartEpochSeconds": 1623801600
    },
    "PatchPromotion": {
      "MinMatchesPerRegionToCount": 200,
      "MinRegionsRolledOut": 5,
      "MaxWaitHoursBeforeForcePromote": 72
    },
    "RiotRateGate": {
      "Enabled": true,
      "BurstTokens": 16,
      "TokensPerPeriod": 3,
      "ReplenishPeriodSeconds": 4,
      "MaxWaitSeconds": 30
    },
    "TimelineIngestion": {
      "Enabled": true,
      "MinuteMark": 15,
      "MaxRetryAttempts": 4,
      "BackfillBatchSize": 1500,
      "BackfillMaxEnqueuesPerRun": 1500,
      "BackfillCurrentPatchOnly": true,
      "PauseWhenApiPriorityRefreshActive": true,
      "BackfillReattemptCooldownMinutes": 60
    },
    "RuneSelectionIntegrityBackfill": {
      "BatchSize": 250,
      "MaxBatchesPerRun": 10
    },
    "SummonerBootstrap": {
      "Enabled": true,
      "PlatformRegion": "NA1",
      "ChallengerSeedCount": 50,
      "LockMinutes": 10
    },
    "MultiRegionIngestion": {
      "Enabled": true,
      "MaxConcurrentRegionBootstraps": 3,
      "HighEloRefreshIntervalHours": 12,
      "Regions": [
        { "Region": "NA1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "EUW1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "KR", "Enabled": true, "Weight": 1.2, "ChallengerSeedCount": 50 },
        { "Region": "EUN1", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "BR1", "Enabled": true, "Weight": 0.8, "ChallengerSeedCount": 50 },
        { "Region": "JP1", "Enabled": true, "Weight": 0.6, "ChallengerSeedCount": 40 },
        { "Region": "TR1", "Enabled": true, "Weight": 0.6, "ChallengerSeedCount": 40 },
        { "Region": "LA1", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "LA2", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "OC1", "Enabled": true, "Weight": 0.4, "ChallengerSeedCount": 30 }
      ]
    }
  }
}
