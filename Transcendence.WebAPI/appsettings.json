{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OperationalLogs": {
    "ServiceName": "webapi",
    "DirectoryPath": "logs",
    "MinLevel": "Information"
  },
  "AllowedHosts": "*",
  "Auth": {
    "Jwt": {
      "RequireKeyInDevelopment": false
    },
    "BootstrapApiKeyEnabledInDevelopmentOnly": true,
    "AdminBootstrap": {
      "Emails": []
    }
  },
  "Jobs": {
    "_comment": "MultiRegionIngestion + ChampionAnalyticsIngestion are mirrored from Transcendence.Service/appsettings.json — the worker owns ingestion; the WebAPI reads them only to render the admin dashboard's per-region 'enabled' flag and health threshold. Keep this region list and MinimumSuccessfulMatchesForCurrentPatch in sync with the worker.",
    "ChampionAnalyticsIngestion": {
      "MinimumSuccessfulMatchesForCurrentPatch": 5000,
      "DataStaleAfterMinutes": 90
    },
    "MultiRegionIngestion": {
      "Enabled": true,
      "MaxConcurrentRegionBootstraps": 3,
      "HighEloRefreshIntervalHours": 12,
      "Regions": [
        { "Region": "NA1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "EUW1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "KR", "Enabled": true, "Weight": 1.2, "ChallengerSeedCount": 50 },
        { "Region": "EUN1", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "BR1", "Enabled": true, "Weight": 0.8, "ChallengerSeedCount": 50 },
        { "Region": "JP1", "Enabled": true, "Weight": 0.6, "ChallengerSeedCount": 40 },
        { "Region": "TR1", "Enabled": true, "Weight": 0.6, "ChallengerSeedCount": 40 },
        { "Region": "LA1", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "LA2", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 },
        { "Region": "OC1", "Enabled": true, "Weight": 0.4, "ChallengerSeedCount": 30 }
      ]
    }
  }
}
