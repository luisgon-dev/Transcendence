{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OperationalLogs": {
    "ServiceName": "webapi",
    "DirectoryPath": "logs",
    "MinLevel": "Information"
  },
  "AllowedHosts": "*",
  "Analytics": {
    "Compute": {
      "MinimumGamesRequired": 100,
      "EarlyPatchMinimumGamesRequired": 40,
      "EarlyPatchWindowHours": 72
    }
  },
  "Auth": {
    "Jwt": {
      "RequireKeyInDevelopment": false
    },
    "BootstrapApiKeyEnabledInDevelopmentOnly": true,
    "AdminBootstrap": {
      "Emails": []
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "MainDatabase": "Server=localhost;Port=5432;Database=transcendence;Password=postgres;Username=postgres"
  },
  "Jobs": {
    "MultiRegionIngestion": {
      "Enabled": true,
      "MaxConcurrentRegionBootstraps": 3,
      "HighEloRefreshIntervalHours": 12,
      "Regions": [
        { "Region": "NA1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "EUW1", "Enabled": true, "Weight": 1.0, "ChallengerSeedCount": 50 },
        { "Region": "KR", "Enabled": true, "Weight": 1.2, "ChallengerSeedCount": 50 },
        { "Region": "EUN1", "Enabled": true, "Weight": 0.5, "ChallengerSeedCount": 30 }
      ]
    }
  }
}
