{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @transcendence/api-client build && next dev -p 3000",
    "build": "pnpm --filter @transcendence/api-client build && next build",
    "start": "next start -p 3000",
    "lint": "pnpm --filter @transcendence/api-client build && eslint . --max-warnings=0",
    "test": "pnpm --filter @transcendence/api-client build && vitest run",
    "test:watch": "pnpm --filter @transcendence/api-client build && vitest"
  },
  "dependencies": {
    "@transcendence/api-client": "workspace:*",
    "@transcendence/web-routes": "workspace:*",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "11.18.2",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  }
}
