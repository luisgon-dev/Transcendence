# Install root-owned mode 0600 as /etc/transcendence-backup.conf.
# Install restic on the host; initialize the repository explicitly with `restic init`.
# Unraid: export a dedicated NFS share, mount/bind it into the Docker LXC, then use:
RESTIC_REPOSITORY=/mnt/transcendence-backups/restic
TRN_BACKUP_MOUNT_POINT=/mnt/transcendence-backups
RESTIC_PASSWORD_FILE=/etc/transcendence-backup.password
# Explicit opt-in: include the private application configuration in each encrypted
# database snapshot. This contains credentials; retain the repository password separately.
# TRN_BACKUP_APP_ENV_FILE=/root/transcendence/.env
# Native commands use PostgreSQL 18 WAL summaries, not repeated logical dumps.
# The monthly full enables summarize_wal with a reload, without a database restart.
# Report expiration candidates while preserving at least this many full+incremental chains.
# Routine native backup never deletes snapshots.
TRN_BACKUP_KEEP_FULL_CHAINS=2
# KiB/s: full scans are rare; daily reads contain changed blocks only.
TRN_BACKUP_FULL_RATE_KIB=16384
TRN_BACKUP_INCREMENTAL_RATE_KIB=4096
TRN_BACKUP_FULL_TIMEOUT_SECONDS=43200
TRN_BACKUP_INCREMENTAL_TIMEOUT_SECONDS=7200
# Skip a redundant daily run just after a full completed.
TRN_BACKUP_SKIP_RECENT_FULL_SECONDS=21600
# Per transport/verification command; systemd also bounds the whole job.
TRN_BACKUP_COMMAND_TIMEOUT_SECONDS=21600
# Share the managed archiver's storage gate and include its local checkpoint
# receipts in the same encrypted database snapshot.
# TRN_BACKUP_ARCHIVE_STATE_DIR=/var/lib/transcendence-archive
# For a manual recovery test on a separate machine, set the original backup
# host name and a large disposable --state directory; omit the live archive lock.
# TRN_BACKUP_SOURCE_HOST=application-source-host
# SFTP is also supported when a dedicated restricted backup account is available:
# RESTIC_REPOSITORY=sftp:transcendence-backup@nas:/backups/transcendence
# Omit TRN_BACKUP_MOUNT_POINT for SFTP or another remote restic backend.
