# Install root-owned mode 0600 as /etc/transcendence-backup.conf.
# Install restic on the host; initialize the repository explicitly with `restic init`.
# Unraid: export a dedicated NFS share, mount/bind it into the Docker LXC, then use:
RESTIC_REPOSITORY=/mnt/transcendence-backups/restic
TRN_BACKUP_MOUNT_POINT=/mnt/transcendence-backups
RESTIC_PASSWORD_FILE=/etc/transcendence-backup.password
# Large production dumps and index rebuilds can exceed 30 minutes. Bound each
# command to six hours; systemd separately bounds the entire backup/restore job.
TRN_BACKUP_COMMAND_TIMEOUT_SECONDS=21600
# SFTP is also supported when a dedicated restricted backup account is available:
# RESTIC_REPOSITORY=sftp:transcendence-backup@nas:/backups/transcendence
# Omit TRN_BACKUP_MOUNT_POINT for SFTP or another remote restic backend.
