# NPM runs in a separate LXC: use the Docker LXC's private LAN address, not loopback.
# Merge the first two values into /root/transcendence/.env before installer adoption.
WEB_BIND_ADDRESS=REPLACE_WITH_DOCKER_LXC_LAN_IP
API_BIND_ADDRESS=REPLACE_WITH_DOCKER_LXC_LAN_IP
TRUSTED_PROXY_NETWORK_1=REPLACE_WITH_NPM_LXC_LAN_IP/32

# For the optional inner edge, pass these values to config/deploy/compose.yml.
RELEASE_EDGE_BIND_ADDRESS=REPLACE_WITH_DOCKER_LXC_LAN_IP
EDGE_TRUSTED_PROXY_CIDRS=REPLACE_WITH_NPM_LXC_LAN_IP/32
# NPM's site forwards HTTP to Docker-LXC-IP:3001; API host forwards to :8082.
