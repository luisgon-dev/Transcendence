# Install as /etc/transcendence-release.conf (root-owned mode 0600).
TRN_RELEASE_ENV_FILE=/root/transcendence/.env
TRN_RELEASE_BASE_URL=https://transcend.kronic.one
TRN_RELEASE_API_URL=https://api.kronic.one
TRN_RELEASE_PROFILE_PATH=/lol/summoners/na/Kronic-NA1
TRN_RELEASE_RETAIN=3
TRN_RELEASE_MODE=replace
# Optional promotion hold: pin a previously verified complete release instead of following latest.
# TRN_RELEASE_PIN=release-<full 40-character revision>
# After configuring and testing the inner edge:
# TRN_RELEASE_MODE=blue-green
# TRN_RELEASE_TRAFFIC_FILE=/var/lib/transcendence-release/traffic/active.yml
# TRN_RELEASE_NETWORK=transcendence_transcendence-net
