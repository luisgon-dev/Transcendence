{
  "data-root": "/var/lib/transcendence-backup/docker-oci",
  "exec-root": "/run/transcendence-restore-docker",
  "pidfile": "/run/transcendence-restore-docker.pid",
  "hosts": [
    "unix:///run/transcendence-restore-docker.sock"
  ],
  "group": "root",
  "bridge": "none",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "log-driver": "local",
  "features": {
    "containerd-snapshotter": true
  },
  "containerd-namespace": "transcendence-restore",
  "containerd-plugins-namespace": "transcendence-restore-plugins"
}
