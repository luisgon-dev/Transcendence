# Copy to config/monitoring/.env before running the monitoring stack.
# Local dev can leave every value at its default (compose.yml has local-friendly fallbacks).

# --- Prod values (documented; set these in the prod .env at /root/transcendence-monitoring/.env) ---
# GRAFANA_ROOT_URL=https://grafana.kronic.one
# GRAFANA_COOKIE_SECURE=true
# PROMETHEUS_EXTERNAL_URL=https://prometheus.kronic.one

# Discord/Slack-compatible incoming webhook the provisioned alert rules notify. Reuse the same
# webhook as the worker's ingestion alerter (Alerts__Webhook__Url). Unset = alerts fire in Grafana
# but are not delivered.
DISCORD_ALERT_WEBHOOK_URL=

# Optional overrides (defaults: 9090 / 3300 / admin / transcendence_transcendence-net)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3300
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin        # local only; prod uses the file secret (compose.prod.yml)
# MONITOR_NETWORK=transcendence_transcendence-net
