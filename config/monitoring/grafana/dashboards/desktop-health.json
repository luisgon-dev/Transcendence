{
  "uid": "trn-desktop-health",
  "panels": [
    {
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0.0
      },
      "targets": [
        {
          "legendFormat": "{{event}} {{outcome}} {{release}} {{os}}",
          "expr": "sum by (release) (increase(transcendence_desktop_events_total{event=\"app_launch\",outcome=\"success\"}[$__range]))",
          "refId": "A"
        }
      ],
      "title": "Launch events by release (not installations)",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 1
