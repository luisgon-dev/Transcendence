{
  "name": "transcendence",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "backend:test": "dotnet test tests/Transcendence.Service.Core.Tests/Transcendence.Service.Core.Tests.csproj -v minimal && dotnet test tests/Transcendence.WebAPI.Tests/Transcendence.WebAPI.Tests.csproj -v minimal && dotnet test tests/Transcendence.IntegrationTests/Transcendence.IntegrationTests.csproj -v minimal",
    "dev:stack:up": "docker compose up --build -d",
    "dev:stack:down": "docker compose down",
    "hooks:install": "git config core.hooksPath .githooks",
    "precommit:api-sync": "pnpm api:gen && git add -- openapi/transcendence.v1.json",
    "precommit:check": "git diff --cached --check",
    "api:spec": "bash scripts/openapi/export.sh",
    "api:client": "pnpm --filter @transcendence/api-client build",
    "api:gen": "pnpm api:spec && pnpm api:client",
    "api:check": "pnpm api:gen && git diff --exit-code -- openapi/transcendence.v1.json",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "perf:web": "pnpm web:build && pnpm perf:web:ci",
    "perf:web:ci": "node scripts/perf/web-lab.mjs --base-url http://127.0.0.1:3000 --routes scripts/perf/routes.ci.json --samples 3 --budgets scripts/perf/web-budgets.json --json-out .performance-artifacts/web-lab.json",
    "perf:api": "k6 run scripts/perf/api-load.js",
    "e2e": "npx playwright test",
    "e2e:local": "BASE_URL=http://localhost:3000 npx playwright test",
    "e2e:stack": "bash scripts/e2e/run-compose-stack.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@transcendence/web-routes": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.5.0"
  }
}
