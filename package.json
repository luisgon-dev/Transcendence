{
  "name": "transcendence",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "6.14.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "rollup@<4.59.0": "4.59.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "backend:test": "dotnet test tests/Transcendence.Service.Core.Tests/Transcendence.Service.Core.Tests.csproj -v minimal && dotnet test tests/Transcendence.WebAPI.Tests/Transcendence.WebAPI.Tests.csproj -v minimal",
    "dev:stack:up": "docker compose up --build -d",
    "dev:stack:down": "docker compose down",
    "hooks:install": "git config core.hooksPath .githooks",
    "precommit:api-sync": "pnpm api:gen && git add -- openapi/transcendence.v1.json",
    "precommit:check": "git diff --cached --check",
    "api:spec": "bash scripts/openapi/export.sh",
    "api:client": "pnpm --filter @transcendence/api-client build",
    "api:gen": "pnpm api:spec && pnpm api:client",
    "api:check": "pnpm api:gen && git diff --exit-code -- openapi/transcendence.v1.json",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test",
    "e2e": "npx playwright test",
    "e2e:local": "BASE_URL=http://localhost:3000 npx playwright test",
    "e2e:stack": "bash scripts/e2e/run-compose-stack.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
