[Unit]
Description=Transcendence full-response and data freshness checks
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/root/deploy/data-health-sweep.sh
Nice=10
# Keep probes low priority without starving their file/command I/O behind database work.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
# Three bounded HTTP checks plus a bounded Docker/DB check, with shutdown margin under I/O pressure.
TimeoutStartSec=75
ProtectSystem=strict
ReadWritePaths=/var/lib/transcendence-perf
StateDirectory=transcendence-perf
StateDirectoryMode=0755
PrivateTmp=true
NoNewPrivileges=true
